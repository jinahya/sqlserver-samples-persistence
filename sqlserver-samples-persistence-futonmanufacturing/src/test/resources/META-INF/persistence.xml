    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <!-- the database from compose.yaml, as its DML-only login; see _compose.sh -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:sqlserver://localhost:1433;encrypt=true;trustServerCertificate=true;databaseName=FutonManufacturing"/>
      <property name="jakarta.persistence.jdbc.user" value="dmlonly"/>
      <property name="jakarta.persistence.jdbc.password" value="Passw0rd!"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <property name="hibernate.format_sql" value="true"/>
