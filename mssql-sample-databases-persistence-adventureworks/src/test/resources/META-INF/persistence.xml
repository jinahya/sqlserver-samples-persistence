<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <!-- named after the database, not just `it`: the modules' test classpaths can meet in one JVM (an IDE running -->
  <!-- every test of the project), and two units sharing a name there is unspecified -->
  <persistence-unit name="adventureworks-it" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for AdventureWorks on a Physical Database</description>
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.mapped.UuidStringAttributeConverter</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.AdditionalContactInfoView</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.Address</class>
