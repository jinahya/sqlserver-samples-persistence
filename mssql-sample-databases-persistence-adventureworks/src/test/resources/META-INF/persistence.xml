    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.StateProvince</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.StateProvinceCountryRegionView</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.Store</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.StoreWithDemographicsView</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.TransactionHistory</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.TransactionHistoryArchive</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.UnitMeasure</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.Vendor</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.VendorWithAddressesView</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.WorkOrder</class>
    <class>com.github.jinahya.mssql.sample.databases.persistence.adventureworks.WorkOrderRouting</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <!-- the database from compose.yaml; see compose.sh -->
      <property name="jakarta.persistence.jdbc.url" value="${mssql.url};databaseName=AdventureWorks"/>
      <property name="jakarta.persistence.jdbc.user" value="${mssql.user}"/>
      <property name="jakarta.persistence.jdbc.password" value="${mssql.password}"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
      <!-- ///////////////////////////////////////////////////////////////////////////////////////////// eclipselink -->
      <property name="eclipselink.ddl-generation" value="none"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
