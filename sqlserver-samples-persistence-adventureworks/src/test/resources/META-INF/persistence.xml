    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- named, and kept while the virtual machine runs, so that every connection of the pool sees one database; -->
      <!-- MSSQLServer mode takes the [Column] of the check constraints -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:adventureworks;MODE=MSSQLServer;DATABASE_TO_UPPER=false;DB_CLOSE_DELAY=-1"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      <!-- //////////////////////////////////////////////////////////////////////////////////// schema generation -->
      <!-- the schema is generated from the mappings, then the script adds what it lacks of the database's
           (defaults, ...); see H2.asciidoc -->
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <property name="jakarta.persistence.schema-generation.create-source" value="metadata-then-script"/>
      <property name="jakarta.persistence.schema-generation.create-script-source"
                value="META-INF/adventureworks/create-test.sql"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <property name="hibernate.format_sql" value="true"/>
      <!-- the schemas (Sales, Person, ...) are created too -->
      <property name="hibernate.hbm2ddl.create_namespaces" value="true"/>
      <!-- a column named after a keyword of H2, such as FutonManufacturing's Month, is quoted -->
      <property name="hibernate.auto_quote_keyword" value="true"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
