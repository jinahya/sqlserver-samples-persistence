<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>sqlserver-samples-persistence</artifactId>
    <version>0.6.11</version>
  </parent>

  <artifactId>sqlserver-samples-persistence-adventureworks</artifactId>
  <version>0.6.11</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>AdventureWorks</description>

  <dependencies>

    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>sqlserver-samples-persistence-common</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- dbo.DatabaseLog.XmlEvent: the converter, and the binding of the EVENTDATA() schema it reads the document with -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-more</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b872ce</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Person.AdditionalContactInfoSchemaCollection: ContactInfo, and the ContactRecord and ContactTypes it holds -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b7fdbe</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b80e2e</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b2e7ae</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Person.Person.Demographics: IndividualSurvey -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b9c1be</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Production.ProductModel.CatalogDescription: its Warranty and Maintenance -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b4347e</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Production.ProductModel.CatalogDescription: ProductDescription -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b0fd0e</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- HumanResources.JobCandidate.Resume: ResumeType -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b3da3e</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Sales.Store.Demographics: StoreSurvey -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b95f5e</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Production.ProductModel.Instructions: Root -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>sqlserver-xml-schema-binding-b73cae</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-object-randomizer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-more-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>nl.jqno.equalsverifier</groupId>
      <artifactId>equalsverifier-nodep</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk-platform-logging</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!--
        With src/main/java/module-info.java the tests are compiled patched into the module. Run on the module path, the
        patched tests would have to be granted a read of every named test library one by one; they run on the class path
        instead.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${version.maven-failsafe}</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <!--
        The test bases every database module shares, in the project root's src/test-shared/java; each module compiles
        them into its own test classes. maven.multiModuleProjectDirectory is the directory holding .mvn, the
        project root, wherever the build is started from.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-shared-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${maven.multiModuleProjectDirectory}/src/test-shared/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
