<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <!-- named after the database, not just `it`: the modules' test classpaths can meet in one JVM (an IDE running -->
  <!-- every test of the project), and two units sharing a name there is unspecified -->
  <persistence-unit name="wideworldimporters-it" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for WideWorldImporters on a Physical Database</description>
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.common.GeographyAttributeConverter</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.BuyingGroup</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.City</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.ColdRoomTemperature</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.Color</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.Country</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.Customer</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.CustomerCategory</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.CustomerTransaction</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.DeliveryMethod</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.Invoice</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.InvoiceLine</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.Order</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.OrderLine</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.PackageType</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.PaymentMethod</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.Person</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.purchasing.PurchaseOrder</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.purchasing.PurchaseOrderLine</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.sales.SpecialDeal</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.StateProvince</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.StockGroup</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.StockItem</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.StockItemHolding</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.StockItemStockGroup</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.StockItemTransaction</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.purchasing.Supplier</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.purchasing.SupplierCategory</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.purchasing.SupplierTransaction</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.SystemParameter</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.application.TransactionType</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.warehouse.VehicleTemperature</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.website.Customer</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.website.Supplier</class>
    <class>com.github.jinahya.sqlserver.sample.databases.persistence.wideworldimporters.website.VehicleTemperature</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <!-- the database from compose.yaml; see compose.sh -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:sqlserver://localhost:1433;encrypt=true;trustServerCertificate=true;databaseName=WideWorldImporters"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="Passw0rd!"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
